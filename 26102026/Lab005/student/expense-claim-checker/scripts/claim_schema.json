{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check_expense_claim",
  "description": "One employee travel-expense claim. Returns per-item verdicts and the approvable amount.",
  "type": "object",
  "required": ["employee_id", "city", "submitted_on", "items"],
  "properties": {
    "employee_id": {"type": "string", "pattern": "^FIL[0-9]{4}$"},
    "city": {"type": "string", "minLength": 2},
    "submitted_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "category", "amount", "receipt"],
        "properties": {
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "category": {"enum": ["meals", "hotel", "local_travel", "other"]},
          "amount": {"type": "number", "exclusiveMinimum": 0},
          "receipt": {"type": "boolean"},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
