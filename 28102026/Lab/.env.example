# =====================================================================
#  Copy this file to .env  (cp .env.example .env)  and fill it in.
#  NEVER commit .env to git - it holds secrets.
#  NEVER paste your client secret or LangSmith key into code, chat,
#  slides or screenshots.
#
#  Two switches drive everything:
#    LLM_MODE  -> where LLM calls go      (enterprise | direct)
#    OBS_MODE  -> where traces go         (fil | otlp | off)
# =====================================================================

# ---- SWITCH 1: LLM ----------------------------------------------------
#   enterprise -> FIL AI Gateway with Azure AD token (inside Fidelity)
#   direct     -> OpenAI / any OpenAI-compatible API with an API key
LLM_MODE=enterprise


# ---- Enterprise (FIL) - used only when LLM_MODE=enterprise ----------
# From your SRM ticket (one set per team). Same values as "Step 1: Generate FilCopilot Token".
FIL_CLIENT_ID=xxxxxx
FIL_CLIENT_SECRET=yyyyyy
FIL_TENANT_ID=zzzzzz
# Gateway URL from the FIL docs (UAT shown)
FIL_BASE_URL=https://fil-ai-gateway-uat.k8s.npiek8sinfra1np1.npaws.ukfilcld/llmproxy/v1
# FilCopilot API host from the FIL docs, for samples that call FilCopilot directly (UAT shown)
FILCOPILOT_HOST=https://uat-api.npeuawsfilxgpt.npaws.ukfilcld
# uat | dev   (picks the token scope; a UAT token is rejected by DEV)
FIL_ENV=uat
# Optional: override the scope completely
# FIL_SCOPE=https://uat.filxgptnp.fil.com/.default


# ---- Direct (no enterprise) - used only when LLM_MODE=direct --------
OPENAI_API_KEY=sk-...
# Leave empty for api.openai.com, or point at any OpenAI-compatible endpoint
OPENAI_BASE_URL=


# ---- Models (the gateway routes by model name) ----------------------
# Grad-training credentials give access to exactly these two models.
# Each mode has independent model names, so changing LLM_MODE is enough.
ENTERPRISE_CHAT_MODEL=azure/gpt-6-luna
ENTERPRISE_EMBED_MODEL=azure/text-embedding-ada-002
DIRECT_CHAT_MODEL=gpt-4o-mini
DIRECT_EMBED_MODEL=text-embedding-3-small
# Legacy CHAT_MODEL / EMBED_MODEL are supported when the mode-specific value is absent.
TTS_MODEL=gpt-4o-mini-tts
STT_MODEL=gpt-4o-transcribe
IMAGE_MODEL=gpt-image-1


# ---- Networking -----------------------------------------------------
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# If the FIL gateway uses an internal certificate and you get
# CERTIFICATE_VERIFY_FAILED, point this at the corporate CA bundle (.pem)
# CA_BUNDLE=C:/certs/fil-root-ca.pem


# ---- SWITCH 2: OBSERVABILITY (OpenTelemetry -> LangSmith) -----------
#   fil  -> fil-aiobs SDK -> FIL AI Observability endpoint -> LangSmith   (inside FIL)
#   otlp -> plain OpenTelemetry -> LangSmith OTLP endpoint               (home / direct mode)
#   off  -> no telemetry (the app works exactly the same)
OBS_MODE=fil

# LangSmith project that receives your traces. Use one per app + environment + person,
# e.g. rag-lab-uat-<yourname>, so the class does not flood one project.
LANGSMITH_PROJECT=Fil-RAGLab-Observability
# LangSmith API key (starts with lsv2_). Sent as x_api_key to the FIL observability endpoint.
LANGSMITH_API_KEY=lsv2_sk_****

# Collector URL. Leave empty for the default of the chosen OBS_MODE:
#   fil  UAT  : https://fil-ai-observability-uat.k8s.npiek8sinfra1np1.npaws.ukfilcld/api/v1/otel
#   fil  PROD : https://fil-ai-observability.k8s.pdiek8sinfra1p1.aws.ukfilcld/api/v1/otel
#   otlp      : https://api.smith.langchain.com/otel   (EU: https://eu.api.smith.langchain.com/otel)
OBS_ENDPOINT=https://fil-ai-observability-uat.k8s.npiek8sinfra1np1.npaws.ukfilcld/api/v1/otel

# Shown on every span (service.name / environment metadata) - filter on them in LangSmith
OBS_SERVICE_NAME=rag-lab
OBS_ENVIRONMENT=uat

# Send prompts and answers? false = metadata only (model, tokens, latency, errors).
# Set to false for anything that may contain client or personal data.
OBS_CAPTURE_CONTENT=true
# Long prompts / answers are cut to this many characters per attribute
OBS_MAX_CONTENT_CHARS=4000
# Also print every span to the console (debugging only - very noisy)
OBS_CONSOLE_EXPORT=false
# Send the W3C traceparent header to the LLM gateway so gateway spans join your trace
OBS_PROPAGATE_CONTEXT=true
# otlp mode only: fraction of traces kept (1.0 = all; 0.1 in high-volume production)
OBS_SAMPLE_RATE=1.0

# Keep LangSmith's *native* SDK tracing OFF. Inside FIL every trace must go through
# the OpenTelemetry route above; turning this on as well would send LangChain/LangGraph
# runs straight to api.smith.langchain.com (blocked inside FIL, duplicates outside).
LANGSMITH_TRACING=false


# ---- Lab 2: Agentic RAG (LangGraph) ----------------------------------
# hybrid (BM25 + semantic, RRF) | mqr_rrf (LLM rewrites first)
AGENT_SEARCH_MODE=hybrid
AGENT_MAX_SUBQUESTIONS=3
AGENT_MAX_ROUNDS=2
AGENT_MAX_REGENERATIONS=1
AGENT_CHECK_ANSWER=true
AGENT_MAX_CONTEXT_CHUNKS=8
AGENT_HISTORY_MESSAGES=6
AGENT_RECURSION_LIMIT=40


# ---- RAG lab (new for this assignment) ------------------------------
# Folder with the knowledge base (.md / .txt). Indexed on startup.
RAG_DOCS_DIR=data/docs
# Text splitter (characters)
CHUNK_SIZE=500
CHUNK_OVERLAP=60
# Basic RAG: chunks retrieved for the user question
BASIC_K=5
# MQR: how many extra queries the LLM writes, and chunks per query
MQR_NUM_QUERIES=3
MQR_K=5
# Also search with the user's original question (recommended)
MQR_INCLUDE_ORIGINAL=true
# RRF: the k constant in 1/(k + rank) and how many chunks go to the LLM
RRF_K=60
FINAL_K=5
# Max characters of context sent to the LLM in the improved prompt
MAX_CONTEXT_CHARS=6000


# ---- Lab 3: Vectorless RAG (tree index + LLM navigation) -------------
# Documents the navigator may open at level 1, sections it may pick below
VECTORLESS_MAX_DOCS=3
VECTORLESS_MAX_SECTIONS=4
# Hard cap on navigation LLM calls per question (1 = pick documents, read them whole)
VECTORLESS_MAX_STEPS=3
# Signposts the navigator reads: llm (12 calls once, cached) | extractive (free) | none (titles only)
VECTORLESS_SUMMARIES=llm
# Cache of LLM summaries, keyed by document content (empty = no cache)
VECTORLESS_CACHE=data/.cache/tree_summaries.json
