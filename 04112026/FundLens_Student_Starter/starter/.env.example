# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
FUNDLENS_LLM_MODE=gateway            # gateway | mock (offline, for tests/CI only)
LLM_GATEWAY_BASE_URL=                # FIL AI Gateway OpenAI-compatible base URL (from your grad-training credentials)
LLM_GATEWAY_API_KEY=                 # your grad-training key
LLM_CHAT_MODEL=azure/gpt-6-luna
LLM_EMBED_MODEL=azure/text-embedding-ada-002
FUNDLENS_LLM_CACHE=1                 # cache LLM responses while developing (turn OFF for the final eval run)
FUNDLENS_KIT_DIR=kit                 # folder containing corpus/, data/, evaluation/ and MANIFEST.sha256 (see README_STARTER)
FUNDLENS_INDEX_DIR=.index
FUNDLENS_DB_PATH=.data/fundlens.sqlite
FUNDLENS_API_URL=http://localhost:8000
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fundlens-team-XX
